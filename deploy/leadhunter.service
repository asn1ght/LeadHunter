# systemd-юнит LeadHunter (вариант без Docker, Ubuntu VPS).
# Установка: см. README → «Деплой без Docker (systemd)».
#   sudo cp deploy/leadhunter.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now leadhunter

[Unit]
Description=LeadHunter Telegram bot
After=network-online.target
Wants=network-online.target
# Если прокси — SSH-туннель (deploy/leadhunter-tunnel.service), раскомментируйте:
# After=network-online.target leadhunter-tunnel.service
# Wants=leadhunter-tunnel.service

[Service]
Type=simple
User=leadhunter
Group=leadhunter
WorkingDirectory=/opt/leadhunter
ExecStart=/opt/leadhunter/.venv/bin/python -m app.main
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
TimeoutStopSec=30

# Ограничения: писать можно только в data/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/leadhunter/data

[Install]
WantedBy=multi-user.target
