# --- Telegram ---
BOT_TOKEN=
ADMIN_IDS=
TZ=Europe/Moscow

# --- База ---
DATABASE_URL=sqlite+aiosqlite:///data/leadhunter.db

# --- Yandex Search API (Yandex Cloud) ---
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SEARCH_REGION=2
YANDEX_SEARCH_MODE=night_v1
YANDEX_PAGES_PER_QUERY=3
YANDEX_GROUPS_ON_PAGE=10
SEARCH_MONTHLY_LIMIT=1000
ALLOW_PAID_SEARCH=false

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
LLM_MONTHLY_BUDGET_RUB=1000
LLM_ENABLED=true
LLM_PRICE_INPUT_PER_1M=30
LLM_PRICE_OUTPUT_PER_1M=120
LLM_QUALITY_MIN_TECH=20

# --- Логика ---
SCORE_THRESHOLD=55
LEADS_DAILY_LIMIT=15
AUDIT_CONCURRENCY=5
DISCOVERY_CRON=0 2 * * 1
DAILY_REPORT_TIME=21:00
WEEKLY_REPORT_DOW=sun
MONTHLY_REPORT_DAY=last
NEW_LEADS_PUSH_TIME=09:30
TEST_STAGE_LABEL=тест

# --- Подпись в письмах ---
OWNER_NAME=
OWNER_PHONE=
OWNER_TELEGRAM=
OWNER_EMAIL=

# --- HTTP ---
HTTP_TIMEOUT=20
USER_AGENT=Mozilla/5.0 (compatible; LeadHunterAudit/1.0)
